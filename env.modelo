# Token de longa duração da Meta (vence em cerca de 60 dias)
INSTAGRAM_ACCESS_TOKEN=COLE_SEU_TOKEN_AQUI
# ID numérico da conta Instagram padrão (17 dígitos, começa com 1784)
INSTAGRAM_BUSINESS_ACCOUNT_ID=COLE_O_ID_DA_CONTA_AQUI

# Obrigatórios na configuração, mas o servidor não os usa nas chamadas
FACEBOOK_APP_ID=nao_usado
FACEBOOK_APP_SECRET=nao_usado

INSTAGRAM_API_VERSION=v22.0
# WARNING impede que a URL com o token seja gravada nos registros
LOG_LEVEL=WARNING
